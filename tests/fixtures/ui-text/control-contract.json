{
  "schema": 1,
  "purpose": "Required semantic regressions for LANG-013, not executed test results or VM effect evidence.",
  "cases": [
    {
      "id": "CD1",
      "paths": ["live::background_for_vm", "wording::guest_progress"],
      "immutable_inputs": ["operation identity", "guest_access", "selected VM identity"],
      "copy_edits": {"operation_title": "Edited title {purpose} 🚀"},
      "expect": {
        "Apply": "apply guest/host purpose unchanged; worker Apply dispatch unchanged",
        "Verify": "verify purpose unchanged; no reinstall claim",
        "Reconcile": "recovery purpose unchanged; no replay",
        "Credentials": "credential-management purpose; no guest connection",
        "ReviewPlan": "plan explanation; no effects",
        "SaveOnly": "save-only explanation; no GPU replay",
        "DeleteProfile": "record deletion explanation; no host GPU/power work",
        "StatusRefresh": "silent background read remains silent; no busy modal",
        "GenericRead": "generic read purpose remains distinct"
      }
    },
    {
      "id": "CD2",
      "paths": ["reporting::transfer_progress", "progress::transfer_fraction"],
      "immutable_inputs": {"bytes": 8000000, "total": 10000000, "files": 1, "count": 2},
      "copy_edits": {"copy_prefix": "Edited transfer label: ", "percent_punctuation": "[80 percent]"},
      "expect": {"fraction": 0.8, "phase": "copying", "setup_verified": false, "zero_total_fraction": null, "invalid_counter_fraction": null, "copy_complete_fraction": 1.0, "copy_complete_setup_verified": false}
    },
    {
      "id": "CD3",
      "paths": ["progress::append_progress", "progress::update_steps", "progress::transfer_update"],
      "immutable_inputs": ["Prepare Running", "Copy 10 percent Running", "Copy 80 percent Running", "Copy Failed", "Copy 90 percent Running"],
      "copy_edits": {"stage": "Edited phase", "status_running": "Working", "status_failed": "Stopped with an error", "separator": " / "},
      "expect": {"event_log_rows": 4, "transfer_updates_reuse_running_row": true, "failed_boundary_preserved_in_event_log": true, "next_running_update_appends_after_failure": true, "step_identity": "immutable stage identity", "existing_model_reused": true, "phase_change_clears_fraction": true, "done_boundary_not_coalesced": true}
    },
    {
      "id": "CD4",
      "paths": ["credentials::is_prompt_cancelled", "live::credential_request_cancelled"],
      "immutable_inputs": {"sentinel": "Guest credential request cancelled. No guest operation was started."},
      "copy_edits": {"cancel_title": "Edited cancellation title", "cancel_body": "Edited cancellation explanation"},
      "expect": {"sentinel_is_cancelled": true, "edited_title_is_cancelled": false, "guest_operation_started": false, "draft_retained": true, "existing_recovery_hold_retained": true, "cancellation_not_success": true}
    },
    {
      "id": "CD5",
      "paths": ["presentation::vm_row", "cards.slint power dot"],
      "immutable_inputs": ["Power::Running", "Power::Off", "Power::Other(42)", "historical", "updating"],
      "copy_edits": {"running": "Edited active label", "stopped": "Edited inactive label", "unknown": "Edited unknown label"},
      "expect": {"Running": "running category", "Off": "stopped category", "Other": "unknown category", "historical": "unknown category", "updating": "unknown category", "colour_does_not_parse_display_label": true}
    },
    {
      "id": "CD6",
      "paths": ["presentation::observed_row", "details.slint status panels"],
      "immutable_inputs": ["Generation 1 unsupported", "Generation 2 authorized", "missing inventory", "explicit setup-required presentation state"],
      "copy_edits": {"unsupported": "Edited unsupported label", "setup_required": "Edited setup label"},
      "expect": {"unsupported_panel_unchanged": true, "eligibility_not_granted_by_label": true, "unknown_health_not_success": true, "setup_panel_only_from_explicit_state": true, "current_live_presenter_does_not_invent_setup_required": true}
    },
    {
      "id": "CD7",
      "paths": ["reporting::technical_error", "diagnostics::failure_details"],
      "immutable_inputs": ["typed component failure", "safe native code", "exact safe component message", "no collected facts"],
      "copy_edits": {"native_heading": "Edited numeric facts heading", "component_heading": "Edited component heading", "absence_text": "Edited unavailable wording"},
      "expect": {"typed_fact_details_visible": true, "native_code_details_visible": true, "safe_component_details_visible": true, "no_fact_details_hidden": true, "visibility_does_not_parse_edited_headings": true}
    },
    {
      "id": "CD8",
      "paths": ["memory::format_gb", "presentation::resource_controls"],
      "immutable_inputs": {"bytes": 6000000001, "physical_capacity": 8278507520},
      "copy_edits": {"unit_label": "Edited memory unit", "capacity_heading": "Edited capacity label"},
      "expect": {"numeric_input": "6.000000001", "request_bytes": 6000000001, "exact_capacity_numeric_input": "8.27850752", "baseline_rounded_endpoint": "8 GB", "numeric_input_not_stripped_from_display_text": true, "retained_below_minimum_request_not_rewritten": true}
    },
    {
      "id": "CD9",
      "paths": ["reporting::operator_error", "reporting::Diagnostic::observation", "reporting::technical_error", "diagnostics::failure_details"],
      "immutable_inputs": ["HGFAIL1 typed envelope", "condition needles", "availability/native-code inputs", "exact safe-message allowlist", "restoration-proof compound markers", "untrusted adapter text"],
      "copy_edits": {"failure_guidance": "Edited safe guidance", "stage_label": "Edited credential-related phase label"},
      "expect": {"classification_unchanged": true, "envelope_and_raw_inputs_unchanged": true, "untrusted_text_not_echoed": true, "allowed_numeric_facts_retained": true, "limits_retained": true, "restoration_hold_retained": true, "static_copy_not_used_as_secret_filter_input": true}
    },
    {
      "id": "CD10",
      "paths": ["SelectedActions::reason", "Slint unavailable/validation emptiness checks"],
      "immutable_inputs": ["blocked action", "allowed fresh review", "invalid draft", "valid draft"],
      "copy_edits": {"blocked_reason": "   \n\t", "allowed_label": "Edited action label"},
      "expect": {"blank_required_reason_rejected_by_contract": true, "blocked_action_not_enabled": true, "allowed_review_not_effect_approval": true, "invalid_draft_not_validated_by_copy": true, "pending_edits_retained": true}
    },
    {
      "id": "CD11",
      "paths": ["gui_model::Inventory::recorded_state", "host_configuration::comparison"],
      "immutable_inputs": {"stage": "Preparation record", "journal_read": "unavailable"},
      "copy_edits": {"stage_label": "Edited preparation-history label"},
      "expect": {"recorded_state_recovery_required": true, "current_guest_health_unknown": true, "host_comparison_journal_discriminator_unchanged": true, "stage_protocol_unchanged": true}
    },
    {
      "id": "CD12",
      "paths": ["diagnostics::additional_details", "OperationDialog duplicate-details condition"],
      "immutable_inputs": ["duplicate summary-only facts", "additional collected facts"],
      "copy_edits": {"summary": "Edited summary", "details_heading": "Edited details heading"},
      "expect": {"additional_facts_remain_reachable": true, "duplicate_suppression_reviewed": true, "no_authority_or_recovery_decision_from_text_similarity": true},
      "validation_note": "Visibility and semantic code tests at LANG-013/LANG-006; separately authorized rendered detail interaction at LANG-009."
    }
  ]
}
