{
  "permissions": {
    "ask": [
      "Bash(*sudo *)",
      "Bash(*gsudo*)",
      "Bash(*runas*)",
      "Bash(*-Verb RunAs*)",
      "Bash(*-Verb runas*)",
      "Bash(*Set-ExecutionPolicy*)",
      "Bash(*reg add*)",
      "Bash(*reg delete*)",
      "Bash(*reg import*)",
      "Bash(*HKLM:*)",
      "Bash(*sc.exe*)",
      "Bash(*schtasks*)",
      "Bash(*Register-ScheduledTask*)",
      "Bash(*Unregister-ScheduledTask*)",
      "Bash(*Enable-WindowsOptionalFeature*)",
      "Bash(*Disable-WindowsOptionalFeature*)",
      "Bash(*Install-WindowsFeature*)",
      "Bash(*Mount-VHD*)",
      "Bash(*Dismount-VHD*)",
      "Bash(*Format-Volume*)",
      "Bash(*diskpart*)",
      "Bash(*winget install*)",
      "Bash(*choco install*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "PowerShell(*sudo *)",
      "PowerShell(*gsudo*)",
      "PowerShell(*runas*)",
      "PowerShell(*-Verb RunAs*)",
      "PowerShell(*-Verb runas*)",
      "PowerShell(*Set-ExecutionPolicy*)",
      "PowerShell(*reg add*)",
      "PowerShell(*reg delete*)",
      "PowerShell(*reg import*)",
      "PowerShell(*HKLM:*)",
      "PowerShell(*sc.exe*)",
      "PowerShell(*schtasks*)",
      "PowerShell(*Register-ScheduledTask*)",
      "PowerShell(*Unregister-ScheduledTask*)",
      "PowerShell(*Enable-WindowsOptionalFeature*)",
      "PowerShell(*Disable-WindowsOptionalFeature*)",
      "PowerShell(*Install-WindowsFeature*)",
      "PowerShell(*Mount-VHD*)",
      "PowerShell(*Dismount-VHD*)",
      "PowerShell(*Format-Volume*)",
      "PowerShell(*diskpart*)",
      "PowerShell(*winget install*)",
      "PowerShell(*choco install*)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git rebase*)",
      "PowerShell(git filter-branch*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)"
    ],
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Lint guard"
          }
        ]
      }
    ]
  }
}
