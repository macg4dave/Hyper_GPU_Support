import { UiText } from "ui-text.slint";
import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Label, Surface } from "theme.slint";

// TextEdit's Fluent colours are not publicly configurable. Keep diagnostics
// neutral with Slint's read-only TextInput and the standard scroll container.
export component TechnicalOutput inherits Rectangle {
    accessible-role: groupbox;
    accessible-label: UiText.dashboard-diagnostics-output-label;
    in property <string> text;
    in property <bool> enabled: true;
    private property <bool> follow-tail: true;
    private property <length> held-y: 0px;
    private property <bool> keyboard-navigation: false;
    min-height: 160px;
    preferred-height: 160px;
    max-height: 220px;
    background: #ffffff;
    border-radius: 4px;
    border-width: 1px;
    border-color: output.has-focus ? Theme.accent : Theme.dialog-border;
    forward-focus: output;
    public function copy-all() {
        output.select-all();
        output.copy();
    }
    FocusScope {
        capture-key-pressed(event) => {
            root.keyboard-navigation = event.text == Key.UpArrow || event.text == Key.DownArrow
                || event.text == Key.LeftArrow || event.text == Key.RightArrow
                || event.text == Key.PageUp || event.text == Key.PageDown
                || event.text == Key.Home || event.text == Key.End;
            reject
        }
        capture-key-released(event) => { root.keyboard-navigation = false; reject }
        ContextMenuArea {
            enabled: root.enabled;
            Menu {
                MenuItem {
                    title: UiText.diagnostics-copy;
                    activated => { output.copy(); output.focus(); }
                }
                MenuItem {
                    title: UiText.diagnostics-select-all;
                    activated => { output.focus(); output.select-all(); }
                }
            }
            VerticalLayout {
                padding: 12px;
                viewport := ScrollView {
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, output.preferred-height);
                    scrolled => {
                        root.held-y = self.content-y;
                        root.follow-tail = self.content-y <= min(0px, self.visible-height - self.content-height) + 2px;
                    }
                    changed content-height => {
                        self.content-y = root.follow-tail ? min(0px, self.visible-height - self.content-height)
                            : max(min(0px, root.held-y), self.visible-height - self.content-height);
                    }
                    changed visible-height => {
                        self.content-y = root.follow-tail ? min(0px, self.visible-height - self.content-height)
                            : max(min(0px, root.held-y), self.visible-height - self.content-height);
                    }
                    output := TextInput {
                        enabled: root.enabled;
                        accessible-label: UiText.diagnostics-read-only-accessible;
                        text: root.text;
                        read-only: true;
                        single-line: false;
                        width: viewport.visible-width;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                        font-family: "Consolas";
                        font-size: 13px;
                        color: #000000;
                        selection-background-color: #005fb8;
                        selection-foreground-color: #ffffff;
                        page-height: viewport.visible-height;
                        cursor-position-changed(position) => {
                            // Binding updates also move the cursor; only explicit navigation
                            // may move a reader who is inspecting earlier output.
                            if root.keyboard-navigation {
                                root.keyboard-navigation = false;
                                if position.x + viewport.content-x < 0px {
                                    viewport.content-x = -position.x;
                                } else if position.x + viewport.content-x > viewport.visible-width - 2px {
                                    viewport.content-x = viewport.visible-width - position.x - 2px;
                                }
                                if position.y + viewport.content-y < 0px {
                                    viewport.content-y = -position.y;
                                } else if position.y + viewport.content-y > viewport.visible-height - self.font-size * 1.5 {
                                    viewport.content-y = viewport.visible-height - position.y - self.font-size * 1.5;
                                }
                                viewport.content-x = max(min(0px, viewport.content-x), viewport.visible-width - viewport.content-width);
                                viewport.content-y = max(min(0px, viewport.content-y), viewport.visible-height - viewport.content-height);
                                root.held-y = viewport.content-y;
                                root.follow-tail = viewport.content-y <= min(0px, viewport.visible-height - viewport.content-height) + 2px;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component DialogLog inherits Surface {
    in property <string> text;
    background: transparent;
    VerticalLayout {
        padding: 8px; spacing: 8px;
        HorizontalLayout {
            Label { text: UiText.dialogs-install-technical; font-weight: 600; horizontal-stretch: 1; }
            Button { text: UiText.dialogs-install-copy-log; clicked => { output.copy-all(); } }
        }
        output := TechnicalOutput { text: root.text; }
    }
}
