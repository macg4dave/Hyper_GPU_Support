import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Label, Hint } from "theme.slint";
import { VmRow, VmCard, Splitter } from "cards.slint";
import { VmDetails } from "details.slint";
import { Pages, GpuRow } from "pages.slint";
import { DemoDialog } from "dialogs.slint";

export component AppWindow inherits Window {
    title: "Hyper GPU Support";
    preferred-width: 1240px; preferred-height: 860px;
    min-width: 700px; min-height: 520px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    in-out property <int> page: 0;
    in-out property <int> theme-index: 0;
    in-out property <int> scenario: 0;
    in property <bool> mock-mode: true;
    in property <bool> snapshot-mode: false;
    in property <string> workspace-label: root.mock-mode ? "MOCK WORKSPACE" : "LIVE WORKSPACE";
    in property <[string]> gpu-options: ["NVIDIA GeForce RTX 5060 · mock", "NVIDIA GeForce RTX 4070 · mock", "AMD Radeon RX 7800 XT · unavailable adapter"];
    in property <string> system-summary;
    in property <[GpuRow]> gpu-information;
    in-out property <[VmRow]> vms: [
        {id: "preview-1", name: "Windows 11 · Design", power: "Running", status: "Configured", gpu: "NVIDIA GeForce RTX 5060", os: "windows"},
        {id: "preview-2", name: "Windows 11 · Development", power: "Stopped", status: "Setup required", gpu: "No GPU assigned", os: "windows"}
    ];
    in-out property <string> selected-id: "preview-1";
    in-out property <string> vm-name: "Windows 11 · Design";
    in-out property <string> power: "Running";
    in-out property <string> status: "Configured";
    in-out property <string> observed: "NVIDIA GeForce RTX 5060 attached (mock)";
    in-out property <string> desired: "GPU enabled · RTX 5060 (mock)";
    in-out property <string> verification: "Last verified in sample session; not currently verified";
    in-out property <bool> eligible: true;
    in-out property <bool> dirty: false;
    in-out property <bool> recovery: false;
    in-out property <bool> gpu-enabled: true;
    in-out property <int> gpu-index: 0;
    in-out property <int> memory-gb: 4;
    in-out property <[string]> values: ["100", "500", "1000", "100", "500", "1000", "100", "500", "1000", "100", "500", "1000"];
    in-out property <string> validation;
    in-out property <string> notice: "Explore safely. This workspace uses sample VMs and GPUs.";
    in-out property <string> dialog-kind;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <[string]> stages;
    in-out property <bool> running: false;
    in-out property <bool> needs-shutdown: false;
    changed dialog-kind => { Theme.modal-active = root.dialog-kind != ""; }
    private property <length> split: 310px;
    callback select-vm(string);
    callback edited();
    callback scenario-changed();
    callback action(string);
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 64px; background: Theme.surface;
            HorizontalLayout { padding: 20px; spacing: 14px;
                Rectangle { width: 30px; height: 30px; border-radius: 7px; background: Theme.navigation; Text { text: "H"; color: Theme.text; font-weight: 700; font-size: 20px; } }
                Label { text: "Hyper GPU Support"; font-size: 18px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                Label { text: root.workspace-label; color: Theme.muted; font-size: 11px; font-weight: 600; }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 184px; background: Theme.navigation;
                VerticalLayout { padding: 14px; padding-top: 20px; spacing: 10px;
                    dashboard := Button { enabled: !Theme.modal-active; text: "Dashboard"; primary: root.page == 0; clicked => { root.page = 0; } }
                    system := Button { enabled: !Theme.modal-active; text: "System"; primary: root.page == 1; clicked => { root.page = 1; } }
                    settings := Button { enabled: !Theme.modal-active; text: "Settings"; primary: root.page == 2; clicked => { root.page = 2; } }
                    about := Button { enabled: !Theme.modal-active; text: "About"; primary: root.page == 3; clicked => { root.page = 3; } }
                    Rectangle { vertical-stretch: 1; }
                    Hint { text: root.snapshot-mode ? "Historical snapshot\nNo backend connection" : root.mock-mode ? "Sample inventory\nNo Hyper-V connection" : "Actual inventory\nShared Rust backend"; }
                    Button { enabled: !Theme.modal-active; text: root.mock-mode ? "Prototype help" : "Help"; clicked => { root.action("shortcuts"); } }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            VerticalLayout {
                spacing: 0px;
                Rectangle { height: root.recovery ? 72px : 42px; background: Theme.tint;
                    HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 12px;
                        Hint { text: root.recovery ? (root.snapshot-mode ? "Historical recovery record requires inspection. Snapshot rehearsal cannot clear or modify it." : root.mock-mode ? "DEMO recovery hold · Outcome uncertain. New GPU changes are blocked until mock reconciliation." : "Pending protected recovery record. New GPU changes are blocked; inspection does not clear recovery.") : root.notice; }
                        if root.recovery : Button { enabled: !Theme.modal-active; text: "Inspect recovery"; clicked => { root.action("recovery"); } }
                    }
                }
                if root.page == 0 : ScrollView {
                    vertical-scrollbar-policy: always-off;
                    content-width: max(self.width - 16px, root.split + 630px);
                    HorizontalLayout {
                        spacing: 0px;
                        Rectangle {
                            width: root.split; background: Theme.vm-panel;
                            VerticalLayout { padding: 16px; spacing: 12px;
                                HorizontalLayout { spacing: Theme.gap; Label { text: "Virtual Machines"; font-size: 17px; font-weight: 600; horizontal-stretch: 1; } Button { enabled: !Theme.modal-active; text: "Refresh"; clicked => { root.action("refresh"); } } }
                                Hint { text: root.vms.length + (root.snapshot-mode ? " historical VMs shown" : root.mock-mode ? " sample VMs shown" : " VMs shown"); }
                                if root.vms.length == 0 : Hint { text: root.mock-mode ? "No sample VMs. Choose a different scenario in Settings." : "No live VM rows available. Check the discovery message or Refresh."; }
                                vm-list := ScrollView {
                                    accessible-role: list;
                                    horizontal-scrollbar-policy: always-off;
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.gap;
                                        padding-top: 2px; padding-bottom: 2px;
                                        for vm in root.vms : VmCard { vm: vm; selected: vm.id == root.selected-id; select(id) => { root.select-vm(id); } }
                                    }
                                }
                            }
                        }
                        divider := Splitter { position <=> root.split; }
                        if root.selected-id != "" : VmDetails {
                            min-width: 610px;
                            mock-mode: root.mock-mode; snapshot-mode: root.snapshot-mode; gpu-options: root.gpu-options;
                            name: root.vm-name; identity: root.selected-id; power: root.power; status: root.status;
                            observed: root.observed; desired: root.desired; verification: root.verification;
                            dirty: root.dirty; eligible: root.eligible; recovery: root.recovery;
                            gpu-enabled <=> root.gpu-enabled; gpu-index <=> root.gpu-index; values <=> root.values;
                            memory-gb <=> root.memory-gb;
                            validation: root.validation;
                            edited => { root.edited(); }
                            action(a) => { root.action(a); }
                        }
                        if root.selected-id == "" : Rectangle {
                            min-width: 610px;
                            VerticalLayout { padding: 40px; spacing: 15px; Label { text: "Your VM workspace starts here"; font-size: 23px; } Hint { text: root.mock-mode ? "Choose a sample VM on the left, or use Settings to load an inventory scenario." : "Choose a discovered VM on the left. Discovery never enrolls or modifies it."; } Rectangle { vertical-stretch: 1; } }
                        }
                    }
                }
                if root.page != 0 : Pages { page: root.page; mock-mode: root.mock-mode; snapshot-mode: root.snapshot-mode; system-summary: root.system-summary; gpu-information: root.gpu-information; theme-index <=> root.theme-index; scenario <=> root.scenario; scenario-changed => { root.scenario-changed(); } action(a) => { root.action(a); } }
            }
        }
        Rectangle { height: 30px; background: Theme.surface;
            HorizontalLayout { padding-left: 18px; padding-right: 18px; Hint { text: root.snapshot-mode ? "Snapshot rehearsal · Historical inventory · No writes" : root.mock-mode ? "Mock GUI · In-memory drafts · No real GPU changes" : "Live GUI · Shared plan previews · Apply unavailable"; } Hint { text: root.running ? (root.snapshot-mode ? "Reading snapshot" : root.mock-mode ? "Demonstration running" : "Backend operation running") : "Ready"; horizontal-alignment: right; } }
        }
    }
    if root.dialog-kind != "" : DemoDialog { mock-mode: root.mock-mode; kind: root.dialog-kind; title: root.dialog-title; body: root.dialog-body; stages: root.stages; running: root.running; needs-shutdown: root.needs-shutdown; action(a) => { root.action(a); } }
}

