import { UiText } from "ui-text.slint";
export { UiText }
import { Button, ScrollView } from "std-widgets.slint";
import { Theme, Label, Hint, Surface } from "theme.slint";
import { VmRow, VmCard, Splitter } from "cards.slint";
import { VmDetails } from "details.slint";
import { Pages, GpuRow } from "pages.slint";
import { StartupSplash } from "startup.slint";
import { OperationDialog } from "dialogs.slint";

export component AppWindow inherits Window {
    title: UiText.common-branding-title;
    preferred-width: 1240px; preferred-height: 860px;
    min-width: 700px; min-height: 520px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    in-out property <bool> startup-loading: true;
    in-out property <string> startup-error;
    in-out property <float> startup-progress: 0;
    in-out property <int> page: 0;
    in-out property <int> theme-index: 0;
    in-out property <bool> execution-ready: false;
    in-out property <bool> updating: false;
    in-out property <string> focus-return-action;
    private property <int> focus-return-serial: 0;
    changed dialog-kind => {
        if root.dialog-kind == "" && !root.startup-loading {
            root.focus-return-serial += 1;
            if root.page != 0 || root.selected-id == "" { dashboard.focus(); }
        }
    }
    in property <bool> gpu-problem: false;
    in property <bool> verify-allowed: false;
    in property <string> verify-unavailable: UiText.dashboard-selection-required;
    in property <bool> repair-allowed: false;
    in property <string> repair-unavailable: UiText.dashboard-selection-required;
    in property <bool> remove-allowed: false;
    in property <string> remove-unavailable: UiText.dashboard-selection-required;
    in property <bool> reset-allowed: false;
    in property <string> reset-unavailable;
    in property <bool> forget-allowed: false;
    in property <string> forget-unavailable: UiText.dashboard-selection-required;
    in property <bool> action-recovery: false;
    in property <bool> gpu-selection-fixed: false;
    in property <[string]> gpu-options;
    in property <string> system-summary;
    in property <[GpuRow]> gpu-information;
    in-out property <[VmRow]> vms;
    in-out property <string> selected-id: "";
    in-out property <string> vm-name: "";
    in-out property <string> power: UiText.common-state-unknown;
    in-out property <string> status: UiText.common-state-unknown;
    in property <bool> vm-unsupported;
    in property <bool> setup-required;
    in property <bool> draft-valid;
    in-out property <string> observed: UiText.dashboard-observation-unread;
    in-out property <string> desired: UiText.dashboard-saved-absent;
    in property <string> pending: UiText.dashboard-draft-absent;
    in property <string> applied: UiText.dashboard-outcome-absent;
    in-out property <string> verification: UiText.dashboard-verification-absent;
    in property <string> support-summary;
    in property <string> inventory-details;
    in property <string> vm-details;
    in-out property <bool> eligible: false;
    in-out property <bool> dirty: false;
    in-out property <bool> recovery: false;
    in property <bool> selected-recovery: false;
    in property <bool> has-recovery: false;
    in property <string> recovery-summary;
    in-out property <bool> gpu-enabled: false;
    in-out property <int> gpu-index: 0;
    in property <bool> memory-available: false;
    in property <int> memory-minimum: 1;
    in property <int> memory-maximum: 2;
    in property <int> memory-position: 1;
    in property <string> memory-input;
    in property <string> memory-capacity;
    in property <string> memory-label: UiText.common-state-unavailable;
    in property <string> memory-hint;
    in property <string> memory-range-start;
    in property <string> memory-range-end;
    in-out property <[string]> values: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in property <[bool]> resource-available: [false, false, false, false];
    in property <[string]> resource-hints: [UiText.dashboard-capability-unknown, UiText.dashboard-capability-unknown, UiText.dashboard-capability-unknown, UiText.dashboard-capability-unknown];
    in property <[string]> resource-defaults: ["", "", "", "", "", "", "", "", "", "", "", ""];
    in property <bool> presenting: false;
    in-out property <string> validation;
    in-out property <string> notice;
    in-out property <string> dialog-kind;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <string> recovery-heading;
    in-out property <string> recovery-vm-id;
    in-out property <string> enrollment-heading;
    in-out property <string> enrollment-allocation;
    in-out property <string> dialog-details;
    in-out property <[string]> stages;
    in-out property <[bool]> stage-reportable;
    in-out property <[string]> progress-steps;
    in-out property <string> current-stage;
    in-out property <float> transfer-fraction: -1;
    in-out property <bool> running: false;
    in-out property <bool> review-preparing: false;
    in-out property <bool> needs-shutdown: false;
    in-out property <string> power-consent;
    private property <bool> modal-active: root.dialog-kind != "" || root.running;
    changed startup-loading => { if !root.startup-loading { dashboard.focus(); } }
    changed modal-active => { Theme.modal-active = root.modal-active; }
    private property <length> split: 310px;
    callback select-vm(string);
    callback edited();
    pure callback memory-text-valid(string) -> bool;
    pure callback memory-text-acceptable(string) -> bool;
    callback memory-edited(int);
    callback memory-text-edited(string);
    callback action(string);
    VerticalLayout {
        visible: !root.startup-loading;
        spacing: 0px;
        Rectangle {
            height: 64px; background: Theme.surface;
            HorizontalLayout { padding: 12px; padding-left: 20px; padding-right: 20px; spacing: 14px;
                Rectangle { width: 30px; height: 30px; border-radius: 7px; background: Theme.navigation; Text { text: UiText.common-branding-monogram; color: Theme.text; font-weight: 700; font-size: 20px; } }
                Label { text: UiText.common-branding-title; font-size: 18px; font-weight: 600; }
                Rectangle { horizontal-stretch: 1; }
                settings := Button {
                    width: 44px; height: 36px;
                    icon: @image-url("icons/settings.svg");
                    colorize-icon: true;
                    accessible-label: UiText.dashboard-navigation-settings;
                    enabled: !Theme.modal-active;
                    primary: root.page != 0;
                    clicked => { if self.enabled { root.page = 2; } }
                }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 184px; background: Theme.navigation;
                VerticalLayout { padding: 14px; padding-top: 20px; spacing: 10px;
                    dashboard := Button { enabled: !Theme.modal-active; text: UiText.dashboard-navigation-dashboard; primary: root.page == 0; clicked => { root.page = 0; } }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }
            VerticalLayout {
                spacing: 0px;
                if root.page == 0 : dashboard-scroll := ScrollView {
                    vertical-scrollbar-policy: always-off;
                    // This viewport scrolls horizontally only. Vertical scrolling
                    // belongs to the VM list and details, above the fixed footer.
                    content-height: self.visible-height;
                    content-width: max(self.width - 16px, root.split + 630px);
                    HorizontalLayout {
                        height: dashboard-scroll.visible-height;
                        spacing: 0px;
                        Rectangle {
                            width: root.split; background: Theme.vm-panel;
                            VerticalLayout { padding: 16px; spacing: 12px;
                                HorizontalLayout { spacing: Theme.gap; Label { text: UiText.dashboard-vm-list-title; font-size: 17px; font-weight: 600; horizontal-stretch: 1; } Button {
                                    property <int> restore-request: root.focus-return-serial;
                                    changed restore-request => { if root.focus-return-action == "refresh" { self.focus(); } }
                                    enabled: !Theme.modal-active; text: UiText.dashboard-inventory-refresh; clicked => { root.action("refresh"); }
                                } }
                                Hint { text: UiText.dashboard-vm-list-count(root.vms.length); }
                                if root.has-recovery : Surface {
                                    VerticalLayout {
                                        padding: 12px; spacing: 10px;
                                        Label { text: UiText.dashboard-recovery-review-label; font-weight: 600; }
                                        Hint { text: root.recovery-summary; color: Theme.accent; }
                                        Button {
                                            property <int> restore-request: root.focus-return-serial;
                                            changed restore-request => { if root.focus-return-action == "recovery" { self.focus(); } }
                                            enabled: !Theme.modal-active; text: UiText.dashboard-recovery-inspect; clicked => { root.action("recovery"); }
                                        }
                                    }
                                }
                                if root.notice != "" : Hint { text: root.notice; color: Theme.accent; }
                                if root.vms.length == 0 : Hint { text: UiText.dashboard-vm-list-empty; }
                                vm-list := ScrollView {
                                    accessible-role: list;
                                    horizontal-scrollbar-policy: always-off;
                                    VerticalLayout {
                                        alignment: start;
                                        spacing: Theme.gap;
                                        padding-top: 2px; padding-bottom: 2px;
                                        for vm in root.vms : VmCard { updating: root.updating; vm: vm; selected: vm.id == root.selected-id; select(id) => { root.select-vm(id); } }
                                    }
                                }
                            }
                        }
                        divider := Splitter { position <=> root.split; }
                        if root.selected-id != "" : VmDetails {
                            focus-return-action: root.focus-return-action;
                            focus-return-serial: root.focus-return-serial;
                            min-width: 610px;
                            gpu-options: root.gpu-options;
                            name: root.vm-name; identity: root.selected-id; power: root.updating ? UiText.dashboard-inventory-updating : root.power; status: root.updating ? "" : root.status;
                            vm-unsupported: !root.updating && root.vm-unsupported; setup-required: !root.updating && root.setup-required; draft-valid: root.draft-valid;
                            observed: root.observed; desired: root.desired; verification: root.verification;
                            pending: root.pending; applied: root.applied;
                            support-summary: root.updating ? UiText.dashboard-inventory-updating-notice : root.support-summary;
                            inventory-details: root.inventory-details;
                            technical-details: root.vm-details;
                            dirty: root.dirty; eligible: root.eligible; recovery: root.recovery;
                            selected-recovery: root.selected-recovery;
                            execution-ready: root.execution-ready; updating: root.updating; gpu-problem: root.gpu-problem; verify-unavailable: root.verify-unavailable; verify-allowed: root.verify-allowed;
                            gpu-selection-fixed: root.gpu-selection-fixed;
                            presenting: root.presenting; resource-defaults: root.resource-defaults;
                            gpu-enabled <=> root.gpu-enabled; gpu-index <=> root.gpu-index; values <=> root.values;
                            resource-available: root.resource-available; resource-hints: root.resource-hints;
                            memory-available: root.memory-available; memory-minimum: root.memory-minimum; memory-maximum: root.memory-maximum; memory-position: root.memory-position;
                            memory-input: root.memory-input; memory-label: root.memory-label; memory-hint: root.memory-hint; memory-range-start: root.memory-range-start; memory-range-end: root.memory-range-end;
                            memory-text-valid(text) => { root.memory-text-valid(text); }
                            memory-text-acceptable(text) => { root.memory-text-acceptable(text); }
                            memory-text-edited(text) => { root.memory-text-edited(text); }
                            memory-edited(position) => { root.memory-edited(position); }
                            validation: root.validation;
                            edited => { root.edited(); }
                            action(a) => { root.action(a); }
                        }
                        if root.selected-id == "" : Rectangle {
                            min-width: 610px;
                            VerticalLayout { padding: 40px; spacing: 15px; Label { text: UiText.dashboard-workspace-title; font-size: 23px; } Hint { text: UiText.dashboard-workspace-body; } Rectangle { vertical-stretch: 1; } }
                        }
                    }
                }
                if root.page != 0 : Pages { page <=> root.page; system-summary: root.system-summary; gpu-information: root.gpu-information; theme-index <=> root.theme-index; action(a) => { root.action(a); } }
            }
        }
        Rectangle { height: 30px; background: Theme.surface;
            HorizontalLayout { padding-left: 18px; padding-right: 18px; Hint { text: root.recovery || root.action-recovery ? UiText.dashboard-status-recovery : root.updating ? UiText.dashboard-status-updating : root.selected-id == "" ? UiText.dashboard-status-selection-required : !root.execution-ready || !root.eligible || !root.draft-valid ? UiText.dashboard-status-prerequisites : root.dirty ? UiText.dashboard-status-draft-pending : UiText.dashboard-status-draft-absent; } Hint { text: root.running ? UiText.dashboard-status-busy : UiText.dashboard-status-idle; horizontal-alignment: right; } }
        }
    }
    if root.startup-loading : StartupSplash {
        error: root.startup-error;
        progress: root.startup-progress;
        continue => { root.startup-loading = false; }
    }
    if !root.startup-loading && root.dialog-kind != "" : OperationDialog {
        execution-ready: root.execution-ready; updating: root.updating;
        verify-unavailable: root.verify-unavailable; verify-allowed: root.verify-allowed; repair-unavailable: root.repair-unavailable; repair-allowed: root.repair-allowed;
        remove-unavailable: root.remove-unavailable; remove-allowed: root.remove-allowed; forget-unavailable: root.forget-unavailable; forget-allowed: root.forget-allowed;
        reset-unavailable: root.reset-unavailable; reset-allowed: root.reset-allowed; action-recovery: root.action-recovery; dirty: root.dirty;
        kind: root.dialog-kind; title: root.dialog-title; body: root.dialog-body;
        enrollment-heading: root.enrollment-heading; enrollment-allocation: root.enrollment-allocation;
        details: root.dialog-details; stages: root.progress-steps; running: root.running;
        review-preparing: root.review-preparing;
        current-stage: root.current-stage; transfer-fraction: root.transfer-fraction;
        recovery-heading: root.recovery-heading;
        needs-shutdown: root.needs-shutdown; power-consent: root.power-consent; action(a) => { root.action(a); }
    }
}

