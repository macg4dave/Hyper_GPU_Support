import { UiText } from "ui-text.slint";
import { Theme } from "theme.slint";

// Shared numeric/raw editor. TextInput retains native keyboard editing while
// explicit colours keep every app text box readable in either theme.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-action-set-value(value) => { if root.enabled { root.text = value; root.edited(value); } }
    accessible-action-set-selection-offsets(anchor, focus) => { input.set-selection-offsets(anchor, focus); }
    min-height: 32px;
    min-width: 86px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: #ffffff;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.dialog-border;
    forward-focus: input;
    ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: UiText.resources-edit-undo; activated => { input.undo(); } }
            MenuItem { title: UiText.resources-edit-redo; activated => { input.redo(); } }
            MenuSeparator { }
            MenuItem { title: UiText.resources-edit-cut; activated => { input.cut(); } }
            MenuItem { title: UiText.diagnostics-copy; activated => { input.copy(); } }
            MenuItem { title: UiText.resources-edit-paste; activated => { input.paste(); } }
            MenuItem { title: UiText.diagnostics-select-all; activated => { input.select-all(); } }
        }
        Rectangle {
            x: 12px; y: 4px; width: max(1px, parent.width - 24px); height: parent.height - 8px;
            clip: true;
            Text {
                text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
                color: #000000; font-size: 14px; vertical-alignment: center;
                width: 100%; height: 100%; accessible-role: none;
            }
            input := TextInput {
                enabled: root.enabled;
                text <=> root.text;
                color: #000000;
                font-size: 14px;
                single-line: true;
                width: parent.width; height: parent.height;
                vertical-alignment: center;
                selection-background-color: #005fb8;
                selection-foreground-color: #ffffff;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
                cursor-position-changed(position) => {
                    if position.x + self.x < 0px { self.x = -position.x; }
                    else if position.x + self.x > parent.width - 2px { self.x = parent.width - position.x - 2px; }
                }
            }
        }
    }
}
