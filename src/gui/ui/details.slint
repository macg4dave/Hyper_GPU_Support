import { Button, Switch, ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { ResourceEditor, AllocationDisclosure } from "resources.slint";

export component VmDetails inherits Rectangle {
    in property <string> name;
    in property <[string]> gpu-options;
    in property <string> identity;
    in property <string> power;
    in property <string> status;
    in property <string> observed;
    in property <string> desired;
    in property <string> verification;
    in property <string> support-summary;
    in property <string> inventory-details;
    in property <bool> dirty;
    in property <bool> eligible;
    in property <bool> recovery;
    in-out property <bool> gpu-enabled;
    in-out property <int> gpu-index;
    in property <bool> memory-available;
    in property <int> memory-minimum;
    in property <int> memory-maximum;
    in property <int> memory-position;
    in property <string> memory-label;
    in property <string> memory-hint;
    in property <string> memory-range-start;
    in property <string> memory-range-end;
    in-out property <[string]> values;
    in property <[bool]> resource-available;
    in property <[string]> resource-hints;
    in property <[string]> resource-defaults;
    in property <bool> presenting;
    in property <string> validation;
    private property <bool> technical: false;
    private property <bool> advanced-expanded: false;
    changed memory-position => { memory-slider.value = root.memory-position; }
    callback edited();
    callback memory-edited(int);
    callback action(string);
    function edit-allocation(index: int, value: string) {
        // Defaults are suggestions until the user edits an omitted triple.
        if value != "" {
            if index < 3 && root.values[0] == "" && root.values[1] == "" && root.values[2] == "" {
                root.values[0] = root.resource-defaults[0]; root.values[1] = root.resource-defaults[1]; root.values[2] = root.resource-defaults[2];
            }
        }
        root.values[index] = value;
        root.edited();
    }
    background: Theme.canvas;
    VerticalLayout {
        padding: 18px; spacing: 14px;
        HorizontalLayout {
            VerticalLayout { spacing: 5px; Heading { text: root.name; } Hint { text: root.power + " · " + root.status; } }
            if root.dirty : Label { text: "● Draft changed"; color: Theme.accent; font-size: 12px; }
        }
        ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 14px;
                alignment: start;
                Surface {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: "GPU support"; font-weight: 600; }
                        Hint { text: root.support-summary; }
                        Switch { enabled: !Theme.modal-active && (root.eligible && !root.recovery); text: "Enable GPU support in this draft"; checked <=> root.gpu-enabled;  toggled => { root.edited(); } }
                        Hint { text: "Physical GPU"; }
                        ComboBox { enabled: !Theme.modal-active && (root.eligible && !root.recovery); model: root.gpu-options; current-index <=> root.gpu-index;  selected => { root.edited(); } }
                        HorizontalLayout {
                            Label { text: "GPU Memory request"; font-weight: 600; }
                            Label { text: root.memory-label; font-weight: 600; horizontal-alignment: right; }
                        }
                        memory-slider := Slider {
                            visible: root.memory-minimum != root.memory-maximum;
                            accessible-label: "Requested GPU memory in GB";
                            accessible-value-step: 1;
                            minimum: root.memory-minimum; maximum: root.memory-maximum; step: 1;
                            value: root.memory-position;
                            enabled: !Theme.modal-active && root.memory-available && root.eligible && !root.recovery;
                            changed(value) => {
                                if !root.presenting && round(value) != root.memory-position { root.memory-edited(round(value)); self.value = root.memory-position; }
                            }
                        }
                        if root.memory-available && root.memory-minimum == root.memory-maximum : Button {
                            text: "Use " + root.memory-range-start;
                            enabled: !Theme.modal-active && root.eligible && !root.recovery;
                            clicked => { root.memory-edited(root.memory-minimum); }
                        }
                        HorizontalLayout { Hint { text: root.memory-range-start; } Hint { text: root.memory-range-end; horizontal-alignment: right; } }
                        Hint { text: root.memory-hint; }
                        Hint { visible: Theme.show-help; text: "Changes take effect only after review and approval. GPU sharing is not qualified."; }
                    }
                }
                if root.status == "Setup required" : Surface {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: "First-time setup"; font-weight: 600; }
                        Hint { text: "This Generation 2 VM has no saved GPU configuration. Review the pairing and enrollment before preparing the guest."; }
                        Button { enabled: !Theme.modal-active; text: "Stage enrollment & NVIDIA preparation"; clicked => { root.action("enroll"); } }
                    }
                }
                if !root.eligible : Surface {
                    VerticalLayout { padding: 16px; spacing: 8px;
                        Label { text: root.status == "Unsupported" ? "This VM is not eligible" : ("Configuration is unavailable"); font-weight: 600; }
                        Hint { text: root.status == "Unsupported" ? "Non-Generation 2 guests are outside the GPU-P workflow." : (root.validation); }
                        Button { enabled: !Theme.modal-active; text: "Inspect diagnostics"; clicked => { root.action("diagnostics"); } }
                    }
                }
                HorizontalLayout {
                    advanced-toggle := AllocationDisclosure { expanded <=> root.advanced-expanded; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.advanced-expanded : VerticalLayout {
                    spacing: 14px;
                    Hint { text: "Exact VRAM request for compatibility with saved settings. Minimum ≤ Optimal ≤ Maximum, in native bytes. Grey defaults are suggestions. Editing an empty group fills its other defaults. Clear all three fields for no explicit write. Only the GPU support toggle disables support."; }
                    ResourceEditor { title: "VRAM"; capability-text: root.resource-hints[0]; minimum : root.values[0]; optimal : root.values[1]; maximum : root.values[2]; default-minimum: root.resource-defaults[0]; default-optimal: root.resource-defaults[1]; default-maximum: root.resource-defaults[2]; editable: (root.resource-available[0] || root.values[0] != "" || root.values[1] != "" || root.values[2] != "") && root.eligible && !root.recovery; edited(index, value) => { root.edit-allocation(index, value); } }
                }
                if root.validation != "" : Hint { text: root.validation; color: Theme.accent; }
                HorizontalLayout {
                    TechnicalDetailsButton { enabled: !Theme.modal-active; expanded <=> root.technical; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.technical : Surface {
                    VerticalLayout { padding: 16px; spacing: 7px;
                        Hint { text: "VM ID: " + root.identity; }
                        Hint { text: "Observed: " + root.observed; }
                        Hint { text: "Saved configuration: " + root.desired; }
                        Hint { text: "Graphics: " + root.verification; }
                        Hint { text: root.inventory-details; }
                        Hint { text: "GPU Memory ranges from 1 GB to the selected GPU's detected physical capacity. Requests use native bytes: 1 GB = 1,000,000,000 bytes. The driver may support a smaller request range; unsupported selections are blocked. Advanced Allocation retains exact VRAM triples, including older values below 1 GB. Saved Compute/Encode/Decode requests are preserved for compatibility and appear in review; this GUI does not edit them. Physical capacity does not rescale requests or establish reservation or enforcement."; }
                        Hint { text: "Protected enrollment: " + root.status; }
                        Hint { text: "Observed attachment: " + root.observed; }
                        Hint { text: "Host partition count and Secure Boot: not queried. CPU, RAM and disks are outside this editor."; }
                    }
                }
            }
        }
        HorizontalLayout { spacing: 8px;
            review := Button { enabled: !Theme.modal-active && (root.dirty && root.eligible && !root.recovery && root.validation == ""); text: "Apply"; primary: true;  clicked => { root.action("review"); } }
            Button { enabled: !Theme.modal-active && (root.dirty); text: "Discard draft";  clicked => { root.action("discard"); } }
            Button { enabled: !Theme.modal-active; text: "More actions…"; clicked => { root.action("more"); } }
        }
    }
}



