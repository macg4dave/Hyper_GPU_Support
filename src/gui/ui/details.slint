import { UiText } from "ui-text.slint";
import { Button, Switch, ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { TextField } from "text-field.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { ResourceEditor, AllocationDisclosure } from "resources.slint";
import { TechnicalOutput } from "technical-output.slint";

export component VmDetails inherits Rectangle {
    in property <string> focus-return-action;
    in property <int> focus-return-serial;
    changed focus-return-serial => {
        if root.focus-return-action != "refresh" && root.focus-return-action != "recovery" {
            root.restore-action-focus(root.focus-return-action);
        }
    }
    callback restore-action-focus(string);
    restore-action-focus(action) => {
        if action == "verify" && root.gpu-problem && root.verify-allowed && !root.recovery && verify-button.enabled { verify-button.focus(); }
        else if action == "review" && review.enabled { review.focus(); }
        else { more-button.focus(); }
    }
    in property <string> name;
    in property <[string]> gpu-options;
    in property <string> identity;
    in property <string> power;
    in property <string> status;
    in property <bool> vm-unsupported;
    in property <bool> setup-required;
    in property <bool> draft-valid;
    in property <string> observed;
    in property <string> desired;
    in property <string> pending;
    in property <string> applied;
    in property <string> verification;
    in property <string> support-summary;
    in property <string> inventory-details;
    in property <string> technical-details;
    in property <bool> dirty;
    in property <bool> eligible;
    in property <bool> execution-ready;
    in property <bool> updating;
    in property <bool> gpu-problem: false;
    in property <bool> verify-allowed: false;
    in property <string> verify-unavailable;
    in property <bool> recovery;
    in property <bool> selected-recovery;
    in property <bool> gpu-selection-fixed;
    in-out property <bool> gpu-enabled;
    in-out property <int> gpu-index;
    in property <bool> memory-available;
    in property <int> memory-minimum;
    in property <int> memory-maximum;
    in property <int> memory-position;
    in property <string> memory-input;
    in property <string> memory-label;
    in property <string> memory-hint;
    in property <string> memory-range-start;
    in property <string> memory-range-end;
    in-out property <[string]> values;
    in property <[bool]> resource-available;
    in property <[string]> resource-hints;
    in property <[string]> resource-defaults;
    in property <bool> presenting;
    in property <string> validation;
    private property <bool> technical: false;
    changed identity => { root.technical = false; }
    changed technical-details => { if root.technical-details == "" { root.technical = false; } }
    private property <bool> advanced-expanded: false;
    changed memory-position => { memory-slider.value = root.memory-position; }
    callback edited();
    callback memory-edited(int);
    pure callback memory-text-valid(string) -> bool;
    pure callback memory-text-acceptable(string) -> bool;
    callback memory-text-edited(string);
    private property <string> accepted-memory-text: root.memory-input;
    private property <bool> valid-memory-text: root.memory-text-valid(numeric-memory.text);
    changed memory-input => { numeric-memory.text = root.memory-input; root.accepted-memory-text = root.memory-input; }
    callback action(string);
    function edit-allocation(index: int, value: string) {
        // Defaults are suggestions until the user edits an omitted triple.
        if value != "" {
            if index < 3 && root.values[0] == "" && root.values[1] == "" && root.values[2] == "" {
                root.values[0] = root.resource-defaults[0]; root.values[1] = root.resource-defaults[1]; root.values[2] = root.resource-defaults[2];
            }
        }
        root.values[index] = value;
        root.edited();
    }
    background: Theme.canvas;
    VerticalLayout {
        padding: 18px; spacing: 14px;
        HorizontalLayout {
            VerticalLayout { spacing: 5px; Heading { text: root.name; } Hint { text: root.power + " · " + root.status; } }
            if root.dirty : Label { text: UiText.dashboard-draft-changed; color: Theme.accent; font-size: 12px; }
        }
        details-scroll := ScrollView {
            min-height: 0px;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            // Conditional sections can overflow the layout's reported preferred
            // height. The trailing marker measures their actual laid-out extent.
            content-height: max(self.visible-height, content-end.y + content-end.height + 18px);
            changed content-height => { self.content-y = max(min(0px, self.content-y), self.visible-height - self.content-height); }
            changed visible-height => { self.content-y = max(min(0px, self.content-y), self.visible-height - self.content-height); }
            details-content := VerticalLayout {
                x: 0px; y: 0px;
                spacing: 14px;
                alignment: start;
                width: details-scroll.visible-width;
                height: self.preferred-height;
                padding-bottom: 18px;
                Surface {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: UiText.dashboard-support-label; font-weight: 600; }
                        Hint { text: root.support-summary; }
                        if root.gpu-problem : Hint { text: UiText.dashboard-support-configuration-warning; color: Theme.accent; }
                        verify-button := Button {
                            visible: root.gpu-problem && !root.recovery;
                            text: UiText.operations-verify-title;
                            primary: !root.dirty;
                            enabled: !Theme.modal-active && root.verify-allowed && root.execution-ready && !root.updating;
                            clicked => { root.action("verify"); }
                        }
                        Switch { enabled: !Theme.modal-active && (root.eligible && !root.recovery); text: UiText.dashboard-support-toggle-accessible; checked <=> root.gpu-enabled;  toggled => { root.edited(); } }
                        Hint { text: UiText.dashboard-gpu-label; }
                        ComboBox { enabled: !Theme.modal-active && root.eligible && !root.recovery && !root.gpu-selection-fixed; model: root.gpu-options; current-index <=> root.gpu-index;  selected => { root.edited(); } }
                        if root.gpu-selection-fixed : Hint { text: UiText.dashboard-gpu-fixed-hint; }
                        Label { text: UiText.dashboard-memory-label; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 8px;
                            memory-slider := Slider {
                                min-width: 80px; horizontal-stretch: 1;
                                accessible-label: UiText.dashboard-memory-slider-accessible;
                                // Internal positions are tenths of a GB. Assistive controls
                                // read and write GB, while pointer/keyboard edits keep exact steps.
                                accessible-value: root.memory-position / 10;
                                accessible-description: root.memory-label;
                                accessible-value-minimum: root.memory-minimum / 10;
                                accessible-value-maximum: root.memory-maximum / 10;
                                accessible-value-step: 0.1;
                                accessible-action-set-value(v) => {
                                    if v.is-float() && v.to-float() >= root.memory-minimum / 10 && v.to-float() <= root.memory-maximum / 10 {
                                        self.changed(round(v.to-float() * 10));
                                    }
                                }
                                accessible-action-increment => { self.changed(min(root.memory-position + 1, root.memory-maximum)); }
                                accessible-action-decrement => { self.changed(max(root.memory-position - 1, root.memory-minimum)); }
                                minimum: root.memory-minimum; maximum: root.memory-maximum; step: 1;
                                value: root.memory-position;
                                enabled: !Theme.modal-active && root.memory-available && root.eligible && !root.recovery;
                                changed(value) => {
                                    if self.enabled && !root.presenting && round(value) != root.memory-position { root.memory-edited(round(value)); self.value = root.memory-position; }
                                }
                            }
                            numeric-memory := TextField {
                                min-width: 86px; preferred-width: 100px; max-width: 130px;
                                horizontal-stretch: 0;
                                accessible-label: UiText.dashboard-memory-input-accessible;
                                placeholder-text: UiText.dashboard-memory-unit;
                                text: root.memory-input;
                                enabled: !Theme.modal-active && root.memory-available && root.eligible && !root.recovery;
                                edited(text) => {
                                    if root.memory-text-acceptable(text) {
                                        root.accepted-memory-text = text;
                                        memory-slider.value = root.valid-memory-text ? round(text.to-float() * 10) : root.memory-position;
                                    } else {
                                        self.text = root.accepted-memory-text;
                                    }
                                }
                                accepted => { if self.enabled && root.valid-memory-text { root.memory-text-edited(self.text); } }
                            }
                            Label { text: UiText.dashboard-memory-unit; }
                            Button {
                                text: UiText.dashboard-memory-submit;
                                horizontal-stretch: 0;
                                enabled: numeric-memory.enabled && root.valid-memory-text;
                                clicked => { if self.enabled { root.memory-text-edited(numeric-memory.text); } }
                            }
                        }
                        HorizontalLayout { Hint { text: root.memory-range-start; } Hint { text: root.memory-range-end; horizontal-alignment: right; } }
                        if root.memory-hint != "" : Hint { text: root.memory-hint; color: Theme.accent; }
                        if root.dirty : Hint { text: root.pending; color: Theme.accent; }
                    }
                }
                if root.setup-required : Surface {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        Label { text: UiText.dashboard-setup-title; font-weight: 600; }
                        Hint { text: UiText.dashboard-setup-body; }
                        Button { enabled: !Theme.modal-active && root.eligible && !root.recovery; text: UiText.dashboard-setup-review-label; clicked => { root.action("reapply"); } }
                    }
                }
                if !root.eligible && !root.recovery : Surface {
                    VerticalLayout { padding: 16px; spacing: 8px;
                        Label { text: root.vm-unsupported ? UiText.dashboard-eligibility-title : (UiText.dashboard-configuration-unavailable-title); font-weight: 600; }
                        Hint { text: root.vm-unsupported ? UiText.dashboard-eligibility-unsupported-body : (root.validation); }
                        Button { enabled: !Theme.modal-active; text: UiText.dashboard-diagnostics-inspect-label; clicked => { root.action("diagnostics"); } }
                    }
                }
                HorizontalLayout {
                    advanced-toggle := AllocationDisclosure { expanded <=> root.advanced-expanded; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.advanced-expanded : VerticalLayout {
                    spacing: 14px;
                    Hint { text: UiText.dashboard-memory-advanced-hint; }
                    ResourceEditor { title: UiText.dashboard-memory-vram-label; capability-text: root.resource-hints[0]; minimum : root.values[0]; optimal : root.values[1]; maximum : root.values[2]; default-minimum: root.resource-defaults[0]; default-optimal: root.resource-defaults[1]; default-maximum: root.resource-defaults[2]; editable: (root.resource-available[0] || root.values[0] != "" || root.values[1] != "" || root.values[2] != "") && root.eligible && !root.recovery; edited(index, value) => { root.edit-allocation(index, value); } }
                }
                if root.validation != "" && !root.recovery : Hint { text: root.validation; color: Theme.accent; }
                if root.technical-details != "" : Surface {
                    VerticalLayout {
                        padding: 16px; spacing: 10px;
                        if root.selected-recovery : Button { text: UiText.dashboard-recovery-inspect; enabled: !Theme.modal-active; clicked => { root.action("recovery"); } }
                        HorizontalLayout {
                            TechnicalDetailsButton { enabled: !Theme.modal-active; expanded <=> root.technical; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.technical : TechnicalOutput { enabled: !Theme.modal-active; text: root.technical-details; }
                    }
                }
                content-end := Rectangle { height: 0px; vertical-stretch: 0; }
            }
        }
        HorizontalLayout { spacing: 8px;
            review := Button { enabled: !Theme.modal-active && (root.dirty && root.eligible && !root.recovery && root.draft-valid); text: UiText.dashboard-apply-label; primary: true;  clicked => { root.action("review"); } }
            Button { enabled: !Theme.modal-active && (root.dirty); text: UiText.dashboard-draft-discard-label;  clicked => { root.action("discard"); } }
            more-button := Button { enabled: !Theme.modal-active; text: UiText.dashboard-actions-more-label; clicked => { root.action("more"); } }
        }
    }
}



