import { UiText } from "ui-text.slint";
import { Button, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { DialogLog } from "technical-output.slint";
import { DialogFrame } from "dialog-frame.slint";

export struct InstallStep {
    label: string,
    // 0 pending, 1 running, 2 reported done, 3 reported failed.
    status: int,
}

export struct InstallFact { label: string, value: string }

// Shared preparation, execution and result presentation. Rust retains operation authority.
export component InstallDialog inherits Rectangle {
    in property <bool> completed;
    in property <bool> running;
    in property <bool> failed;
    in property <bool> review-preparing;
    in property <string> kind;
    in property <string> title;
    in property <[string]> phases;
    in property <int> active-phase;
    in property <bool> action-recovery;
    in property <bool> dirty;
    in property <bool> execution-ready;
    in property <bool> repair-allowed;
    in property <bool> forget-allowed;
    in property <bool> guest-work;
    in property <bool> updating;
    in property <string> vm-name;
    in property <string> gpu-name;
    in property <string> vram;
    in property <string> body;
    in property <string> details;
    in property <string> current-stage;
    in property <string> transfer;
    in property <float> transfer-fraction: -1;
    in property <[InstallStep]> steps;
    in property <[InstallFact]> facts;
    private property <bool> technical: false;
    changed kind => { root.technical = false; content.content-y = 0px; root.focus-safe(); }
    changed review-preparing => { root.focus-safe(); }
    changed completed => {
        root.technical = false;
        content.content-y = 0px;
        root.focus-safe();
    }
    changed technical => {
        content.content-y = root.technical ? min(0px, content.visible-height - content.content-height) : 0px;
    }
    callback close();
    callback action(string);
    function focus-safe() {
        if root.completed || root.review-preparing { close-button.focus(); }
        else { dialog-focus.focus(); }
    }
    function reveal-action(x: length, width: length) {
        if x + footer.content-x < 0px { footer.content-x = -x; }
        else if x + width + footer.content-x > footer.visible-width { footer.content-x = footer.visible-width - x - width; }
    }
    init => { root.focus-safe(); }
    dialog-focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.review-preparing || (root.completed && !root.running) { root.close(); }
                accept
            } else { reject }
        }
        DialogFrame {
            phases: root.phases; active-phase: root.active-phase;
            VerticalLayout {
                min-height: 0px; spacing: 16px;
                content := ScrollView {
                    min-height: 0px; vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout {
                        width: content.visible-width;
                        padding-right: 4px; spacing: 16px; alignment: start;
                        Heading { text: root.title; min-width: 0px; wrap: word-wrap; overflow: clip; }
                        Rectangle {
                            background: Theme.install-information;
                            border-radius: Theme.radius;
                            VerticalLayout {
                                padding: 16px; spacing: 8px;
                                Label { text: UiText.dialogs-install-vm + " " + root.vm-name; font-weight: 700; min-width: 0px; wrap: word-wrap; overflow: clip; }
                                Label { text: UiText.dialogs-install-gpu-type + " " + root.gpu-name; font-weight: 700; min-width: 0px; wrap: word-wrap; overflow: clip; }
                                Label { text: UiText.dialogs-install-vram + " " + root.vram; font-weight: 700; min-width: 0px; wrap: word-wrap; overflow: clip; }
                            }
                        }
                        if root.completed : Label { text: root.body; min-width: 0px; wrap: word-wrap; overflow: clip; }
                        if !root.completed && root.guest-work : Hint { text: UiText.dialogs-install-windows-warning; min-width: 0px; }
                        if !root.completed : Surface {
                            background: transparent;
                            VerticalLayout {
                                padding: 16px; spacing: 8px;
                                Label { text: root.current-stage; min-width: 0px; wrap: word-wrap; overflow: clip; font-weight: 600; }
                                HorizontalLayout {
                                    spacing: 16px;
                                    ProgressIndicator { indeterminate: root.transfer-fraction < 0; progress: max(0, root.transfer-fraction); height: 8px; horizontal-stretch: 1; }
                                    if root.transfer-fraction >= 0 : Label { text: round(root.transfer-fraction * 100) + "%"; font-weight: 700; }
                                }
                                if root.transfer != "" : Hint { text: root.transfer; font-size: 13px; min-width: 0px; }
                                if !root.technical : VerticalLayout {
                                    spacing: 10px; padding-top: 12px;
                                    for step in root.steps : HorizontalLayout {
                                        spacing: 12px;
                                        Label { text: step.label; font-size: 14px; min-width: 0px; wrap: word-wrap; overflow: clip; horizontal-stretch: 1; }
                                        Hint { text: step.status == 0 ? UiText.dialogs-install-pending : step.status == 1 ? UiText.dialogs-busy-label : step.status == 2 ? UiText.progress-status-complete : UiText.progress-status-failed; font-size: 13px; }
                                    }
                                }
                            }
                        }
                        if root.completed && !root.failed && root.facts.length > 0 && !root.technical : Surface {
                            background: transparent;
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                Label { text: UiText.dialogs-install-summary; font-weight: 700; }
                                for fact[index] in root.facts : VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Label { text: fact.label; min-width: 0px; preferred-width: 180px; wrap: word-wrap; overflow: clip; }
                                        Label { text: fact.value; min-width: 0px; horizontal-stretch: 1; wrap: word-wrap; overflow: clip; }
                                    }
                                    if index < root.facts.length - 1 : Rectangle { height: 1px; background: Theme.line; }
                                }
                            }
                        }
                        if root.technical : DialogLog { text: root.details; }

                    }
                }
                footer := ScrollView {
                    min-width: 0px; vertical-stretch: 0;
                    horizontal-scrollbar-policy: as-needed; vertical-scrollbar-policy: always-off;
                    content-width: max(self.visible-width, footer-buttons.min-width);
                    content-height: footer-buttons.preferred-height;
                    min-height: footer-buttons.preferred-height + (self.content-width > self.visible-width ? 16px : 0px);
                    max-height: self.min-height; preferred-height: self.min-height;
                    footer-buttons := HorizontalLayout {
                        x: 0px; y: 0px; width: footer.content-width; height: self.preferred-height;
                        vertical-stretch: 0; spacing: 12px;
                        if !root.completed : TechnicalDetailsButton {
                            changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            expanded <=> root.technical;
                            accessible-expandable: true; accessible-expanded: root.technical;
                            icon: root.technical ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); colorize-icon: true;
                        }
                        if root.completed : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: root.technical ? UiText.dialogs-install-hide-log : UiText.dialogs-install-view-log; accessible-expandable: true; accessible-expanded: root.technical; clicked => { root.technical = !root.technical; } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.failed && root.action-recovery : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-recovery-review-label; enabled: !root.updating; clicked => { root.action("recovery"); } }
                        if root.kind == "profile-deleted" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-setup-new-review-label; enabled: root.execution-ready && !root.updating && !root.action-recovery; clicked => { root.action("reapply"); } }
                        if root.kind == "reset-complete" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-repair-review-label; enabled: root.execution-ready && !root.updating && root.repair-allowed; clicked => { root.action("repair"); } }
                        if root.kind == "reset-complete" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: root.dirty ? UiText.dialogs-profile-deletion-discard-review-label : UiText.dialogs-profile-deletion-review-label; enabled: root.execution-ready && !root.updating && !root.action-recovery && (root.dirty || root.forget-allowed); clicked => { root.action(root.dirty ? "discard-review-forget" : "forget"); } }
                        if root.kind == "save" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.operations-save-only-progress-title; enabled: root.execution-ready && !root.updating; clicked => { root.action("save-only"); } }
                        close-button := Button {
                            changed x => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            changed width => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: root.review-preparing ? UiText.dialogs-cancel-label : root.completed ? UiText.dialogs-close-label : UiText.dialogs-install-cancel;
                            primary: root.completed; min-width: root.completed ? 120px : 160px;
                            enabled: root.review-preparing || (root.completed && !root.running);
                            clicked => { if self.enabled { root.close(); } }
                        }

                    }
                }
            }
        }
    }
}
