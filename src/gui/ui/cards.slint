import { UiText } from "ui-text.slint";
import { Theme, Label, Hint, Surface } from "theme.slint";

export struct VmRow { id: string, name: string, power: string, status: string, gpu: string, os: string, power-running: bool, power-stopped: bool, unsupported: bool }

component GuestOsIcon inherits Rectangle {
    in property <string> os;
    width: Theme.os-icon-size;
    height: Theme.button-height;
    background: #ffffff;
    border-radius: 4px;
    accessible-role: image;
    accessible-label: root.os == "windows" ? UiText.dashboard-os-windows-accessible : root.os == "linux" ? UiText.dashboard-os-linux-accessible : UiText.dashboard-os-unknown-accessible;
    Image {
        source: root.os == "windows" ? @image-url("icons/windows.svg") : root.os == "linux" ? @image-url("icons/linux.svg") : @image-url("icons/monitor.svg");
        // A fixed light plate keeps all bundled asset colours readable in both themes.
        width: Theme.os-icon-size; height: Theme.os-icon-size;
    }
}

export component VmCard inherits Surface {
    in property <VmRow> vm;
    in property <bool> updating;
    in property <bool> selected;
    callback select(string);
    min-width: 0px;
    height: 132px;
    accessible-role: button;
    accessible-label: root.vm.name;
    accessible-enabled: !Theme.modal-active;
    forward-focus: keyboard;
    background: root.selected ? Theme.tint : Theme.surface;
    border-color: keyboard.has-focus ? Theme.accent : Theme.line;
    accessible-action-default => { if !Theme.modal-active { root.select(root.vm.id); } }
    keyboard := FocusScope {
        enabled: !Theme.modal-active;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.select(root.vm.id); return accept; }
            return reject;
        }
    }
    if root.selected : Rectangle { x: 0; y: 14px; width: 3px; height: parent.height - 28px; background: Theme.accent; border-radius: 1px; }
    TouchArea { enabled: !Theme.modal-active; clicked => { keyboard.focus(); root.select(root.vm.id); } }
    VerticalLayout {
        padding: 14px; spacing: 7px;
        HorizontalLayout {
            spacing: 10px;
            GuestOsIcon { os: root.vm.os; }
            Label { min-width: 0px; text: root.vm.name; horizontal-stretch: 1; horizontal-alignment: left; overflow: elide; }
        }
        HorizontalLayout {
            spacing: 7px;
            Rectangle {
                width: Theme.status-dot-size;
                Rectangle {
                    width: Theme.status-dot-size; height: Theme.status-dot-size; border-radius: Theme.status-dot-size / 2;
                    background: root.updating ? Theme.unknown : root.vm.power-running ? Theme.running : root.vm.power-stopped ? Theme.stopped : Theme.unknown;
                }
            }
            Label { text: root.updating ? UiText.dashboard-inventory-updating : root.vm.power; font-size: 12px; }
            Label { text: root.updating ? "" : root.vm.status; font-size: 12px; color: Theme.muted; horizontal-alignment: right; }
        }
        Hint { text: root.updating ? "" : root.vm.gpu; }
    }
    Tooltip {
        Surface {
            max-width: 400px;
            VerticalLayout { padding: 10px; Label { text: root.vm.name; wrap: word-wrap; overflow: clip; } }
        }
    }
}

export component Splitter inherits Rectangle {
    in-out property <length> position: 310px;
    width: 10px;
    background: drag.has-hover || drag.pressed ? Theme.tint : Theme.canvas;
    Rectangle { width: 2px; height: 38px; background: Theme.line; border-radius: 1px; }
    drag := TouchArea {
        mouse-cursor: ew-resize;
        enabled: !Theme.modal-active;
        moved => { if self.pressed { root.position = max(250px, min(480px, root.position + self.mouse-x - self.pressed-x)); } }
    }
}

