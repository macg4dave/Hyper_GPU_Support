import { Button, CheckBox, ScrollView, Palette } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface } from "theme.slint";

export struct GpuRow { name: string, description: string }

export component Pages inherits Rectangle {
    in property <int> page;
    in property <string> system-summary;
    in property <[GpuRow]> gpu-information;
    in-out property <int> theme-index: 0;
    callback action(string);
    background: Theme.canvas;
    ScrollView {
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            padding: 28px; spacing: 18px;
            Heading { text: root.page == 2 ? "Settings" : root.page == 1 ? "System information" : "About Hyper GPU Support"; }
            Hint { text: root.page == 2 ? "Make the workspace yours. Preferences reset on launch." : root.page == 1 ? "Virtual machines and GPUs discovered on this computer." : "Manage GPU support for existing Hyper-V virtual machines."; }
            if root.page == 1 : VerticalLayout {
                spacing: 18px;
                Surface { VerticalLayout { padding: 22px; spacing: 10px; Label { text: "This computer"; font-weight: 600; } Hint { text: root.system-summary; } } }
                for gpu in root.gpu-information : Surface { VerticalLayout { padding: 22px; spacing: 10px; Label { text: gpu.name; font-weight: 600; } Hint { text: gpu.description; } } }
            }

            if root.page == 2 : VerticalLayout {
                spacing: 18px;
                Surface { VerticalLayout { padding: 22px; spacing: 12px;
                    Label { text: "Appearance"; font-weight: 600; }
                    Hint { text: "Theme"; }
                    HorizontalLayout { spacing: 10px;
                        Button { enabled: !Theme.modal-active; text: "Follow Windows"; primary: root.theme-index == 0; clicked => { root.theme-index = 0; Palette.color-scheme = ColorScheme.unknown; } }
                        Button { enabled: !Theme.modal-active; text: "Light"; primary: root.theme-index == 1; clicked => { root.theme-index = 1; Palette.color-scheme = ColorScheme.light; } }
                        Button { enabled: !Theme.modal-active; text: "Dark"; primary: root.theme-index == 2; clicked => { root.theme-index = 2; Palette.color-scheme = ColorScheme.dark; } }
                    }
                    CheckBox { enabled: !Theme.modal-active; text: "Show contextual help"; checked <=> Theme.show-help; }
                    Hint { text: "Fluent controls follow the selected palette immediately."; }
                } }

                Surface { VerticalLayout { padding: 22px; spacing: 10px;
                    Label { text: "Credentials & diagnostics"; font-weight: 600; }
                    Hint { text: "Guest credentials use the native Windows dialog for the selected enrolled VM. Remember is an explicit opt-in to this user's Credential Manager."; }
                    Button { enabled: !Theme.modal-active; text: "Guest credentials for selected VM"; clicked => { root.action("credentials"); } }
                } }
            }
            if root.page == 3 : VerticalLayout {
                spacing: 18px;
                Surface { VerticalLayout { padding: 24px; spacing: 14px;
                    Heading { text: "Hyper GPU Support"; }
                    Label { text: "Hyper GPU Support · 0.1.0"; }
                    Hint { text: "Review and approve GPU support changes for your virtual machines. Available operations depend on setup, supported GPU capabilities and recovery status."; }
                    Hint { text: "Explicit CLI commands retain their existing capabilities. Unconnected GUI operations never produce simulated success."; }
                    Label { text: "Designed for existing VMs"; font-weight: 600; }
                    Hint { text: "NVIDIA first. Further vendor support and simultaneous GPU sharing require independent qualification."; }
                    Button { enabled: !Theme.modal-active; text: "View application help"; clicked => { root.action("shortcuts"); } }
                } }
            }
            Rectangle { min-height: 12px; vertical-stretch: 1; }
        }
    }
}

