import { UiText } from "ui-text.slint";
import { Button, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { DialogLog } from "technical-output.slint";
import { DialogFrame } from "dialog-frame.slint";

component ActionChoice inherits Rectangle {
    min-width: 0px;
    in property <string> label;
    in property <string> reason;
    in property <bool> allowed;
    in property <bool> ready;
    in property <bool> updating;
    in property <bool> show-reason: true;
    callback activate();
    VerticalLayout {
        spacing: 4px;
        Button { text: root.label; enabled: root.allowed && root.ready && !root.updating; clicked => { if self.enabled { root.activate(); } } }
        if root.show-reason && (root.updating || !root.allowed || !root.ready) : Hint { min-width: 0px; text: root.updating ? UiText.dialogs-availability-updating : !root.allowed ? root.reason : UiText.dialogs-availability-setup-required; }
    }
}

export component OperationDialog inherits Rectangle {
    in property <bool> execution-ready: false;
    in property <bool> updating: false;
    in property <bool> verify-allowed: false;
    in property <string> verify-unavailable;
    in property <bool> repair-allowed: false;
    in property <string> repair-unavailable;
    in property <bool> remove-allowed: false;
    in property <string> remove-unavailable;
    in property <bool> forget-allowed: false;
    in property <string> forget-unavailable;
    in property <bool> reset-allowed: false;
    in property <string> reset-unavailable;
    in property <bool> action-recovery;
    in property <bool> dirty;
    in property <string> kind;
    in property <string> title;
    in property <[string]> phases;
    in property <int> active-phase;
    in property <string> body;
    in property <string> recovery-heading;
    in property <string> details;
    in property <[string]> stages;
    in property <string> current-stage;
    in property <float> transfer-fraction: -1;
    in property <bool> running;
    in property <bool> review-preparing;
    private property <bool> technical: false;
    private property <bool> follow-progress: true;
    changed kind => { root.follow-progress = true; root.technical = false; root.focus-safe(); }
    changed title => { root.technical = false; }
    changed technical => { body-scroll.content-y = root.technical ? min(0px, body-scroll.visible-height - body-scroll.content-height) : 0px; }
    changed body => { root.technical = false; }
    changed details => { if !root.running { root.technical = false; } }
    changed running => { root.focus-safe(); }
    changed review-preparing => { root.focus-safe(); }
    function focus-safe() {
        if root.review-preparing { dismiss-button.focus(); }
        else if root.running { dialog-focus.focus(); }
        else { dismiss-button.focus(); }
    }
    function reveal-action(x: length, width: length) {
        if root.kind != "more" {
            if x + action-scroll.content-x < 0px { action-scroll.content-x = -x; }
            else if x + width + action-scroll.content-x > action-scroll.visible-width {
                action-scroll.content-x = action-scroll.visible-width - x - width;
            }
        }
    }
    init => { root.focus-safe(); }
    callback action(string);
    dialog-focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.review-preparing || !root.running { root.action("close"); }
                accept
            } else { reject }
        }
        DialogFrame {
            phases: root.phases; active-phase: root.active-phase;
            VerticalLayout {
                min-height: 0px; spacing: 16px;
                Heading { text: root.title; wrap: word-wrap; overflow: clip; min-width: 0px; vertical-stretch: 0; }
                body-scroll := ScrollView {
                    min-height: 0px;
                    preferred-height: 400px;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout { spacing: 14px; alignment: start; padding-right: 8px;
                        width: body-scroll.visible-width;
                        if root.recovery-heading != "" : Label {
                            text: root.recovery-heading; font-size: 18px; font-weight: 600;
                            width: max(0px, body-scroll.visible-width - 8px);
                            wrap: word-wrap; overflow: clip;
                        }
                        if root.kind == "more" : Label { text: root.body; font-size: 18px; font-weight: 600; width: max(0px, body-scroll.visible-width - 8px); wrap: word-wrap; overflow: clip; }
                        if root.kind != "more" : Rectangle {
                            background: Theme.tint; border-radius: Theme.radius;
                            VerticalLayout { padding: 16px;
                                Hint { text: root.body; color: Theme.text; font-size: 14px; min-width: 0px; wrap: word-wrap; overflow: clip; }
                            }
                        }
                        if root.kind == "more" : VerticalLayout {
                            spacing: 12px;
                            ActionChoice { label: UiText.operations-verify-title; reason: root.verify-unavailable; allowed: root.verify-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("verify"); } }
                            ActionChoice { label: UiText.dialogs-repair-label; reason: root.repair-unavailable; allowed: root.repair-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("repair"); } }
                            ActionChoice { label: UiText.dialogs-removal-label; reason: root.remove-unavailable; allowed: root.remove-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("remove-gpu"); } }
                            ActionChoice { label: UiText.dialogs-profile-deletion-label; show-reason: false; allowed: root.forget-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("forget"); } }
                        }
                        if root.technical && root.details != "" && root.details != root.body : DialogLog { text: root.details; }
                    }
                }
                if root.running && root.current-stage != "" : Hint { text: root.current-stage; vertical-stretch: 0; }
                if root.stages.length > 0 : Rectangle {
                    min-height: 0px; preferred-height: 180px;
                    vertical-stretch: 1;
                    clip: true;
                    progress-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        changed content-height => {
                            if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                        }
                        changed visible-height => {
                            if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                        }
                        scrolled => {
                            root.follow-progress = self.content-y <= min(0px, self.visible-height - self.content-height) + 2px;
                        }
                        VerticalLayout {
                            spacing: 8px; alignment: start; padding-right: 8px;
                            width: progress-scroll.visible-width;
                            for stage in root.stages : Hint {
                                text: stage; font-size: 13px;
                                width: max(0px, progress-scroll.visible-width - 8px);
                                wrap: word-wrap; overflow: clip;
                            }
                        }
                    }
                }
                if root.running : ProgressIndicator {
                    indeterminate: root.transfer-fraction < 0;
                    progress: max(0, root.transfer-fraction);
                    height: 6px;
                    vertical-stretch: 0;
                }

                if root.kind == "more" : FlexboxLayout {
                    spacing: 8px;
                    vertical-stretch: 0;
                    if root.action-recovery : Button { text: UiText.dialogs-recovery-review-label; enabled: !root.running && !root.updating; clicked => { if self.enabled { root.action("recovery"); } } }
                    if root.dirty && !root.action-recovery : Button { text: UiText.dialogs-apply-review-label; enabled: root.execution-ready && !root.updating; clicked => { if self.enabled { root.action("review"); } } }
                    if root.dirty : Button { text: UiText.dialogs-draft-discard-label; enabled: !root.running && !root.updating; clicked => { if self.enabled { root.action("discard"); } } }
                }
                if root.kind == "reset-complete" : Hint {
                    text: root.updating ? UiText.dashboard-inventory-updating-notice : !root.forget-allowed && !root.dirty ? root.forget-unavailable : UiText.dialogs-enrollment-new-permission-hint;
                    vertical-stretch: 0;
                }
                action-scroll := ScrollView {
                    min-width: 0px;
                    vertical-stretch: 0;
                    horizontal-scrollbar-policy: root.kind == "more" ? always-off : as-needed;
                    vertical-scrollbar-policy: always-off;
                    content-width: root.kind == "more" ? self.visible-width : max(self.visible-width, action-buttons.min-width);
                    content-height: action-buttons.preferred-height;
                    // Reserve space below the buttons for Fluent's overlay scrollbar.
                    min-height: action-buttons.preferred-height + (self.content-width > self.visible-width ? 16px : 0px);
                    preferred-height: self.min-height;
                    max-height: self.min-height;
                    action-buttons := HorizontalLayout {
                        x: 0px; y: 0px;
                        width: action-scroll.content-width;
                        height: self.preferred-height;
                        spacing: 12px;
                        vertical-stretch: 0;

                        if root.details != "" && root.details != root.body : TechnicalDetailsButton { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } expanded <=> root.technical; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.kind == "recovery" : Button { text: UiText.operations-recovery-inspection-continue-label; enabled: !root.running && !root.updating && root.execution-ready; clicked => { if self.enabled { root.action("reconcile"); } } }
                        if root.kind == "switch" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-switch-discard-label; clicked => { if self.enabled { root.action("switch"); } } }
                        if root.kind == "switch" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-switch-review-label; primary: true; clicked => { if self.enabled { root.action("review"); } } }
                        if root.kind == "exit" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-exit-discard-label; clicked => { if self.enabled { root.action("exit"); } } }
                        if root.kind == "save" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.operations-save-only-progress-title; primary: true; enabled: root.execution-ready; clicked => { if self.enabled { root.action("save-only"); } } }
                        if root.kind == "recovery-blocked" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-profile-deletion-label; enabled: !root.running && !root.updating; clicked => { if self.enabled { root.action("forget-recovery-profile"); } } }
                        if root.kind == "recovery-needed" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } } text: UiText.dialogs-recovery-review-label; primary: true; enabled: !root.running; clicked => { if self.enabled { root.action("recovery"); } } }
                        if root.kind == "status-error" || root.kind == "recovery-blocked" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: UiText.dialogs-status-retry-label; enabled: !root.updating;
                            clicked => { if self.enabled { root.action("refresh"); } }
                        }
                        if root.kind == "permission-saved" || root.kind == "profile-deleted" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: root.kind == "permission-saved" ? UiText.dialogs-setup-continue-label : UiText.dialogs-setup-new-review-label;
                            enabled: root.execution-ready && !root.updating && (root.dirty || root.kind == "profile-deleted") && !root.action-recovery;
                            clicked => { if self.enabled { root.action(root.kind == "profile-deleted" ? "reapply" : "review"); } }
                        }
                        if root.kind == "reset-complete" || root.kind == "recovery-ended" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: UiText.dialogs-repair-review-label;
                            enabled: root.execution-ready && !root.updating && root.repair-allowed;
                            clicked => { if self.enabled { root.action("repair"); } }
                        }
                        if root.kind == "error" && root.action-recovery : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: UiText.dialogs-recovery-review-label; enabled: !root.updating;
                            clicked => { if self.enabled { root.action("recovery"); } }
                        }
                        if root.kind == "reset-complete" : Button { changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: root.dirty ? UiText.dialogs-profile-deletion-discard-review-label : UiText.dialogs-profile-deletion-review-label;
                            enabled: root.execution-ready && !root.updating && !root.action-recovery && (root.dirty || root.forget-allowed);
                            clicked => { if self.enabled { root.action(root.dirty ? "discard-review-forget" : "forget"); } }
                        }
                        dismiss-button := Button {
                        changed x => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                        changed width => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            changed has-focus => { if self.has-focus { root.reveal-action(self.x, self.width); } }
                            text: root.review-preparing ? UiText.dialogs-cancel-label : root.running ? UiText.dialogs-busy-label : root.kind == "switch" ? UiText.dialogs-switch-stay-label : root.kind == "exit" ? UiText.dialogs-draft-keep-label : UiText.dialogs-close-label;
                            enabled: root.review-preparing || !root.running;
                        min-width: 120px;
                        primary: root.kind == "info" || root.kind == "error";
                            clicked => { if self.enabled { root.action("close"); } }
                        }
                    }
                }

            }
        }
    }
}
