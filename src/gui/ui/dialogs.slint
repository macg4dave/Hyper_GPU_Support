import { Button, CheckBox, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { TechnicalOutput } from "technical-output.slint";

export component OperationDialog inherits Rectangle {
    in property <bool> execution-ready: false;
    in property <string> kind;
    in property <string> title;
    in property <string> body;
    in property <string> details;
    in property <[string]> stages;
    in property <bool> running;
    in property <bool> needs-shutdown;
    private property <bool> consent: false;
    private property <bool> technical: false;
    private property <bool> follow-progress: true;
    changed kind => { root.follow-progress = true; }
    changed body => { root.consent = false; }
    init => { detail-button.focus(); }
    callback action(string);
    background: #00000088;
    TouchArea { }
    HorizontalLayout {
        padding: 24px;
        Rectangle { horizontal-stretch: 1; }
        Surface {
            max-width: 620px; min-width: 0px; preferred-width: 620px;
            min-height: 0px;
            clip: true;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Label { text: "Hyper GPU Support"; font-size: 11px; font-weight: 600; color: Theme.muted; }
                Heading { text: root.title; wrap: word-wrap; overflow: clip; min-width: 0px; }
                body-scroll := ScrollView {
                    min-height: 0px;
                    preferred-height: root.stages.length > 0 ? 90px : 240px;
                    max-height: root.stages.length > 0 ? 130px : 10000px;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    VerticalLayout { spacing: 14px; alignment: start; padding-right: 8px;
                        width: body-scroll.visible-width;
                        Hint { text: root.body; font-size: 14px; width: max(0px, body-scroll.visible-width - 8px); horizontal-stretch: 1; wrap: word-wrap; overflow: clip; }
                    }
                }
                if root.stages.length > 0 : Rectangle {
                    min-height: 0px; preferred-height: 180px; max-height: 240px;
                    vertical-stretch: 1;
                    clip: true;
                    progress-scroll := ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        changed content-height => {
                            if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                        }
                        changed visible-height => {
                            if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                        }
                        scrolled => {
                            root.follow-progress = self.content-y <= min(0px, self.visible-height - self.content-height) + 2px;
                        }
                        VerticalLayout {
                            spacing: 8px; alignment: start; padding-right: 8px;
                            width: progress-scroll.visible-width;
                            for stage in root.stages : Hint {
                                text: stage; font-size: 13px;
                                width: max(0px, progress-scroll.visible-width - 8px);
                                wrap: word-wrap; overflow: clip;
                            }
                        }
                    }
                }
                if root.running : ProgressIndicator { indeterminate: true; }
                if root.technical : TechnicalOutput {
                    vertical-stretch: 1;
                    text: root.details != "" ? root.details : root.body;
                }
                if (root.kind == "review" || root.kind == "verify-review" || root.kind == "recovery") && root.needs-shutdown : CheckBox { text: "Approve graceful guest shutdown and safe restoration"; checked <=> root.consent; }
                if root.kind == "review" && !root.execution-ready : Hint { text: "Apply is unavailable. Close this review and use Refresh to check setup or recovery."; color: Theme.accent; }
                HorizontalLayout {
                    spacing: 8px;
                    if root.kind == "switch" : Button { text: "Stay on VM"; clicked => { root.action("close"); } }
                    if root.kind == "switch" : Button { text: "Discard & Switch"; clicked => { root.action("switch"); } }
                    if root.kind == "switch" : Button { text: "Review Changes"; primary: true; clicked => { root.action("review"); } }
                    if root.kind == "exit" : Button { text: "Keep editing"; clicked => { root.action("close"); } }
                    if root.kind == "exit" : Button { text: "Discard & Close"; clicked => { root.action("exit"); } }
                    if root.kind == "enroll-review" : Button { text: "Keep editing"; clicked => { root.action("close"); } }
                    if root.kind == "enroll-review" : Button { text: "Allow GPU management"; primary: true; enabled: root.execution-ready; clicked => { root.action("confirm-enroll"); } }
                    if root.kind == "enrollment-recovery" : Button { text: "Reconcile enrollment authority"; primary: true; enabled: root.execution-ready; clicked => { root.action("reconcile-enrollment"); } }
                    if root.kind == "review" : Button { text: "Cancel"; clicked => { root.action("close"); } }
                    if root.kind == "review" : Button { text: root.execution-ready ? "Apply" : "Apply unavailable"; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("confirm"); } }
                    if root.kind == "verify-review" : Button { text: "Verify approved graphics"; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("confirm-verify"); } }
                    if root.kind == "save" : Button { text: "Retry configuration save only"; primary: true; enabled: root.execution-ready; clicked => { root.action("save-only"); } }
                    if root.kind == "recovery" : Button { text: "Reconcile observed outcome"; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("reconcile"); } }
                    if root.kind == "more" : Button { text: "Verify Graphics"; enabled: root.execution-ready; clicked => { root.action("verify"); } }
                    if root.kind == "more" : Button { text: "Reapply / Update"; clicked => { root.action("reapply"); } }
                    close-button := Button { visible: root.kind != "review" && root.kind != "enroll-review" && root.kind != "switch" && root.kind != "exit"; text: root.running ? "Operation in progress" : "Close"; enabled: !root.running; clicked => { root.action("close"); } }
                }
                HorizontalLayout {
                    detail-button := TechnicalDetailsButton { expanded <=> root.technical; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
