import { UiText } from "ui-text.slint";
import { Button, CheckBox, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme, Heading, Label, Hint, Surface, TechnicalDetailsButton } from "theme.slint";
import { TechnicalOutput } from "technical-output.slint";

component ActionChoice inherits Rectangle {
    min-width: 0px;
    in property <string> label;
    in property <string> reason;
    in property <bool> allowed;
    in property <bool> ready;
    in property <bool> updating;
    callback activate();
    VerticalLayout {
        spacing: 4px;
        Button { text: root.label; enabled: root.allowed && root.ready && !root.updating; clicked => { root.activate(); } }
        Hint { min-width: 0px; text: root.updating ? UiText.dialogs-availability-updating : !root.allowed ? root.reason : !root.ready ? UiText.dialogs-availability-setup-required : UiText.dialogs-availability-review-hint; }
    }
}

export component OperationDialog inherits Rectangle {
    in property <bool> execution-ready: false;
    in property <bool> updating: false;
    in property <bool> verify-allowed: false;
    in property <string> verify-unavailable;
    in property <bool> repair-allowed: false;
    in property <string> repair-unavailable;
    in property <bool> remove-allowed: false;
    in property <string> remove-unavailable;
    in property <bool> forget-allowed: false;
    in property <string> forget-unavailable;
    in property <bool> reset-allowed: false;
    in property <string> reset-unavailable;
    in property <bool> action-recovery;
    in property <bool> dirty;
    in property <string> kind;
    in property <string> title;
    in property <string> body;
    in property <string> details;
    in property <[string]> stages;
    in property <string> current-stage;
    in property <float> transfer-fraction: -1;
    in property <bool> running;
    in property <bool> review-preparing;
    in property <bool> needs-shutdown;
    in property <string> power-consent;
    private property <bool> consent: false;
    private property <bool> technical: false;
    private property <bool> follow-progress: true;
    changed kind => { root.follow-progress = true; root.technical = false; root.consent = false; root.focus-safe(); }
    changed title => { root.technical = false; }
    changed body => { root.consent = false; root.technical = false; }
    changed details => { if !root.running { root.technical = false; } }
    changed power-consent => { root.consent = false; }
    changed running => { root.focus-safe(); }
    changed review-preparing => { root.focus-safe(); }
    function focus-safe() {
        if root.review-preparing { dismiss-button.focus(); }
        else if root.running { dialog-focus.focus(); }
        else { dismiss-button.focus(); }
    }
    init => { root.focus-safe(); }
    callback action(string);
    background: #00000088;
    TouchArea { }
    dialog-focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.review-preparing || (!root.running && !root.updating) { root.action("close"); }
                accept
            } else { reject }
        }
        HorizontalLayout {
            padding: 24px;
            Rectangle { horizontal-stretch: 1; }
            Surface {
                background: Theme.dialog-surface;
                border-color: Theme.dialog-border;
                max-width: 620px; min-width: 0px; preferred-width: 620px;
                min-height: 0px;
                clip: true;
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Label { text: UiText.common-branding-title; font-size: 11px; font-weight: 600; color: Theme.muted; vertical-stretch: 0; }
                    Heading { text: root.title; wrap: word-wrap; overflow: clip; min-width: 0px; vertical-stretch: 0; }
                    body-scroll := ScrollView {
                        min-height: 0px;
                        preferred-height: root.stages.length > 0 ? 90px : 240px;
                        max-height: root.stages.length > 0 ? 130px : 10000px;
                        vertical-stretch: 1;
                        horizontal-scrollbar-policy: always-off;
                        content-width: self.visible-width;
                        VerticalLayout { spacing: 14px; alignment: start; padding-right: 8px;
                            width: body-scroll.visible-width;
                            Hint { text: root.body; font-size: 14px; width: max(0px, body-scroll.visible-width - 8px); horizontal-stretch: 1; wrap: word-wrap; overflow: clip; }
                            if (root.kind == "review" || root.kind == "verify-review" || root.kind == "recovery" || root.kind == "reset-review") && root.needs-shutdown : Hint {
                                text: root.power-consent; font-size: 14px;
                                width: max(0px, body-scroll.visible-width - 8px);
                            }
                            if root.kind == "more" : VerticalLayout {
                                spacing: 12px;
                                ActionChoice { label: UiText.operations-verify-title; reason: root.verify-unavailable; allowed: root.verify-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("verify"); } }
                                ActionChoice { label: UiText.dialogs-repair-label; reason: root.repair-unavailable; allowed: root.repair-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("repair"); } }
                                ActionChoice { label: UiText.dialogs-removal-label; reason: root.remove-unavailable; allowed: root.remove-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("remove-gpu"); } }
                                ActionChoice { label: UiText.dialogs-profile-deletion-label; reason: root.forget-unavailable; allowed: root.forget-allowed; ready: root.execution-ready; updating: root.updating; activate => { root.action("forget"); } }
                            }
                        }
                    }
                    if root.running && root.current-stage != "" : Hint { text: root.current-stage; vertical-stretch: 0; }
                    if root.stages.length > 0 : Rectangle {
                        min-height: 0px; preferred-height: 180px;
                        vertical-stretch: 1;
                        clip: true;
                        progress-scroll := ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            content-width: self.visible-width;
                            changed content-height => {
                                if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                            }
                            changed visible-height => {
                                if root.follow-progress { self.content-y = min(0px, self.visible-height - self.content-height); }
                            }
                            scrolled => {
                                root.follow-progress = self.content-y <= min(0px, self.visible-height - self.content-height) + 2px;
                            }
                            VerticalLayout {
                                spacing: 8px; alignment: start; padding-right: 8px;
                                width: progress-scroll.visible-width;
                                for stage in root.stages : Hint {
                                    text: stage; font-size: 13px;
                                    width: max(0px, progress-scroll.visible-width - 8px);
                                    wrap: word-wrap; overflow: clip;
                                }
                            }
                        }
                    }
                    if root.running : ProgressIndicator {
                        indeterminate: root.transfer-fraction < 0;
                        progress: max(0, root.transfer-fraction);
                        height: 6px;
                        vertical-stretch: 0;
                    }
                    if root.technical && root.details != "" && root.details != root.body : TechnicalOutput {
                        vertical-stretch: 1;
                        text: root.details;
                    }
                    if (root.kind == "review" || root.kind == "verify-review" || root.kind == "recovery" || root.kind == "reset-review") && root.needs-shutdown : CheckBox {
                        text: UiText.dialogs-power-consent-label;
                        accessible-label: root.power-consent;
                        enabled: !root.running;
                        checked <=> root.consent;
                    }
                    if root.kind == "review" && !root.execution-ready : Hint { text: UiText.dialogs-apply-unavailable-hint; color: Theme.accent; }
                    FlexboxLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        dismiss-button := Button {
                            text: root.review-preparing ? UiText.dialogs-cancel-label : root.running ? UiText.dialogs-busy-label : root.kind == "switch" ? UiText.dialogs-switch-stay-label : root.kind == "exit" || root.kind == "enroll-review" ? UiText.dialogs-draft-keep-label : root.kind == "review" || root.kind == "verify-review" || root.kind == "forget-review" ? UiText.dialogs-cancel-label : UiText.dialogs-close-label;
                            enabled: root.review-preparing || (!root.running && !root.updating);
                            clicked => { root.action("close"); }
                        }
                        if root.kind == "switch" : Button { text: UiText.dialogs-switch-discard-label; clicked => { root.action("switch"); } }
                        if root.kind == "switch" : Button { text: UiText.dialogs-switch-review-label; primary: true; clicked => { root.action("review"); } }
                        if root.kind == "exit" : Button { text: UiText.dialogs-exit-discard-label; clicked => { root.action("exit"); } }
                        if root.kind == "enroll-review" : Button { text: UiText.dialogs-enrollment-confirm-label; primary: true; enabled: root.execution-ready; clicked => { root.action("confirm-enroll"); } }
                        if root.kind == "enrollment-recovery" : Button { text: UiText.dialogs-enrollment-reconcile-label; primary: true; enabled: root.execution-ready; clicked => { root.action("reconcile-enrollment"); } }
                        if root.kind == "forget-review" : Button { text: UiText.dialogs-profile-deletion-label; primary: true; enabled: root.execution-ready; clicked => { root.action("confirm-forget"); } }
                        if root.kind == "review" : Button { text: root.execution-ready ? UiText.dialogs-apply-label : UiText.dialogs-apply-unavailable-label; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("confirm"); } }
                        if root.kind == "verify-review" : Button { text: UiText.operations-verify-title; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("confirm-verify"); } }
                        if root.kind == "save" : Button { text: UiText.operations-save-only-progress-title; primary: true; enabled: root.execution-ready; clicked => { root.action("save-only"); } }
                        if root.kind == "recovery" : Button { text: UiText.operations-recovery-progress-title; primary: true; enabled: root.execution-ready && (!root.needs-shutdown || root.consent); clicked => { root.action("reconcile"); } }
                        if root.kind == "recovery" || root.kind == "recovery-blocked" : Button { text: UiText.dialogs-partial-removal-review-label; enabled: root.execution-ready && !root.updating && root.reset-allowed; clicked => { root.action("review-reset"); } }
                        if root.kind == "reset-review" : Button { text: UiText.dialogs-partial-removal-confirm-label; primary: true; enabled: root.execution-ready && !root.updating && (!root.needs-shutdown || root.consent); clicked => { root.action("confirm-reset"); } }
                        if root.kind == "recovery-needed" : Button { text: UiText.dialogs-recovery-review-label; primary: true; enabled: !root.running; clicked => { root.action("recovery"); } }
                    }
                    if root.kind == "recovery" || root.kind == "recovery-blocked" : Hint {
                        text: root.updating ? UiText.dialogs-partial-removal-checking : !root.reset-allowed ? root.reset-unavailable : UiText.dialogs-partial-removal-available;
                        vertical-stretch: 0;
                    }
                    if root.kind == "status-error" || root.kind == "recovery-blocked" : Button {
                        text: UiText.dialogs-status-retry-label; enabled: !root.updating;
                        clicked => { root.action("refresh"); }
                    }
                    if root.kind == "permission-saved" || root.kind == "profile-deleted" : Button {
                        text: root.kind == "permission-saved" ? UiText.dialogs-setup-continue-label : UiText.dialogs-setup-new-review-label;
                        enabled: root.execution-ready && !root.updating && (root.dirty || root.kind == "profile-deleted") && !root.action-recovery;
                        clicked => { root.action(root.kind == "profile-deleted" ? "reapply" : "review"); }
                    }
                    if root.kind == "reset-complete" || root.kind == "recovery-ended" : Button {
                        text: UiText.dialogs-repair-review-label;
                        enabled: root.execution-ready && !root.updating && root.repair-allowed;
                        clicked => { root.action("repair"); }
                    }
                    if root.kind == "error" && root.action-recovery : Button {
                        text: UiText.dialogs-recovery-review-label; enabled: !root.updating;
                        clicked => { root.action("recovery"); }
                    }
                    if root.kind == "reset-complete" : Hint {
                        text: root.updating ? UiText.dashboard-inventory-updating-notice : !root.forget-allowed && !root.dirty ? root.forget-unavailable : UiText.dialogs-enrollment-new-permission-hint;
                        vertical-stretch: 0;
                    }
                    if root.kind == "reset-complete" : Button {
                        text: root.dirty ? UiText.dialogs-profile-deletion-discard-review-label : UiText.dialogs-profile-deletion-review-label;
                        enabled: root.execution-ready && !root.updating && !root.action-recovery && (root.dirty || root.forget-allowed);
                        clicked => { root.action(root.dirty ? "discard-review-forget" : "forget"); }
                    }
                    if root.kind == "more" : FlexboxLayout {
                        spacing: 8px;
                        vertical-stretch: 0;
                        if root.action-recovery : Button { text: UiText.dialogs-recovery-review-label; enabled: !root.running && !root.updating; clicked => { root.action("recovery"); } }
                        if root.dirty && !root.action-recovery : Button { text: UiText.dialogs-apply-review-label; enabled: root.execution-ready && !root.updating; clicked => { root.action("review"); } }
                        if root.dirty : Button { text: UiText.dialogs-draft-discard-label; enabled: !root.running && !root.updating; clicked => { root.action("discard"); } }
                        Button { text: UiText.dialogs-inventory-refresh-label; enabled: !root.running && !root.updating; clicked => { root.action("refresh"); } }
                    }
                    if root.details != "" && root.details != root.body : HorizontalLayout {
                        vertical-stretch: 0;
                        detail-button := TechnicalDetailsButton { expanded <=> root.technical; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
